{"name":"Axion Video Player","short_name":"Axion","description":"Fast video player that works offline","start_url":"/","scope":"/","display":"standalone","background_color":"#0b0e19","theme_color":"#0b0e19",
"icons":[{"src":"/icon-192.png","sizes":"192x192","type":"image/png"},{"src":"/icon-512.png","sizes":"512x512","type":"image/png"},{"src":"/icon-maskable.png","sizes":"512x512","type":"image/png","purpose":"maskable"}],
"file_handlers":[{"action":"/","accept":{"video/*":[".mp4",".m4v",".webm",".mkv",".mov",".ogv"],"audio/*":[".mp3",".m4a"]}}],
"launch_handler":{"client_mode":"focus-existing"}}
